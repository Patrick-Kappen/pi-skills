{
  "name": "@pi-platform/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "dead-code": "knip",
    "duplicates": "jscpd packages --min-tokens 70 --threshold 0",
    "architecture": "dependency-cruiser --config .dependency-cruiser.cjs packages"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@vitest/coverage-v8": "^3.2.0",
    "dependency-cruiser": "^16.10.0",
    "jscpd": "^4.0.0",
    "knip": "^5.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
