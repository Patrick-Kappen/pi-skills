{
  "name": "pi-skills",
  "version": "0.7.0",
  "private": true,
  "description": "pi agent skills in a Nix flake, loaded per repository by the repo-skills extension",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Patrick-Kappen/pi-skills"
  },
  "engines": {
